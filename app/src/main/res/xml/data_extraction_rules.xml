<?xml version="1.0" encoding="utf-8"?>
<!--
  备份规则：本应用含 SQLCipher 加密的账目数据库、明文运行日志（files/logs）
  以及 Keystore 托管的加密偏好。任何一项都不应离开设备。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
